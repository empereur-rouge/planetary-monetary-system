# =============================================================================
# Caddyfile Production - pms-network.com
# =============================================================================
# Caddy gère automatiquement Let's Encrypt (renouvellement inclus)

# API Endpoint (principal)
api.pms-network.com {
    # TLS automatique via Let's Encrypt
    
    # Headers de sécurité
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        # CORS pour le SDK/navigateurs
        Access-Control-Allow-Origin "*"
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # Compression
    encode gzip zstd

    # Health check sans logs
    @health path /livez /healthz
    handle @health {
        reverse_proxy node:8080 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    # Proxy vers le nœud PMS
    reverse_proxy node:8080 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

# Redirection du domaine principal vers l'API
pms-network.com {
    redir https://api.pms-network.com{uri} permanent
}

www.pms-network.com {
    redir https://api.pms-network.com{uri} permanent
}