# ---------- build base ----------
FROM rust:1.89-alpine AS build-base
# make: required for jemalloc (tikv-jemallocator) build
# clang18-dev: provides libclang.so for bindgen (librocksdb-sys)
RUN apk add --no-cache musl-dev pkgconfig openssl-dev make clang18-dev g++ linux-headers
ENV LIBCLANG_PATH=/usr/lib/llvm18/lib
# Disable static CRT linking so build scripts are dynamically linked against musl.
# This allows dlopen(libclang.so) to work in build scripts (static musl can't dlopen).
ENV RUSTFLAGS="-C target-feature=-crt-static"
WORKDIR /app
COPY . .

# Build node
FROM build-base AS build-node
RUN cargo build --release -p bin

# Build cli (utile en test/dev)
FROM build-base AS build-cli
RUN cargo build --release -p tools-cli

# ---------- runtime node ----------
FROM alpine:3.20 AS node
# libstdc++ + libgcc: required because binary is dynamically linked (-crt-static off)
RUN apk add --no-cache ca-certificates libstdc++ libgcc
COPY --from=build-node /app/target/release/bin /usr/local/bin/pms-node
USER 65532:65532
EXPOSE 8050 8080
HEALTHCHECK --interval=5s --timeout=2s --retries=30 CMD wget -qO- http://127.0.0.1:8080/live || exit 1
ENTRYPOINT ["/usr/local/bin/pms-node"]

# ---------- runtime cli ----------
FROM alpine:3.20 AS cli
RUN apk add --no-cache ca-certificates libstdc++ libgcc
COPY --from=build-cli /app/target/release/tools-cli /usr/local/bin/tools-cli
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/tools-cli"]
